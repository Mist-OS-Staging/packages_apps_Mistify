<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    xmlns:lineage="http://schemas.android.com/apk/res-auto"
    android:title="@string/status_bar_title" >

    <PreferenceCategory
        android:key="status_bar_gestures_category"
        android:title="@string/gestures_category_title">

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="double_tap_sleep_gesture"
            android:title="@string/status_bar_double_tap_to_sleep_title"
            android:summary="@string/status_bar_double_tap_to_sleep_summary"
            android:defaultValue="true" />

        <!-- Status bar brightness control -->
        <org.mist.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_brightness_control"
            android:title="@string/status_bar_toggle_brightness_title"
            android:summary="@string/status_bar_toggle_brightness_summary"
            android:defaultValue="false" />

        <org.mist.settings.preferences.SystemSettingSwitchPreference 
            android:key="status_bar_brightness_control_lockscreen"
            android:title="@string/status_bar_toggle_brightness_lockscreen_title"
            android:summary="@string/status_bar_toggle_brightness_lockscreen_summary"
            android:defaultValue="false"
            android:dependency="status_bar_brightness_control" />

        <!-- Quick pull down -->
        <lineageos.preference.LineageSystemSettingListPreference
            android:key="qs_quick_pulldown"
            android:title="@string/status_bar_quick_qs_pulldown_title"
            android:entries="@array/status_bar_quick_qs_pulldown_entries"
            android:entryValues="@array/status_bar_quick_qs_pulldown_values"
            android:defaultValue="0" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="status_bar_features_category"
        android:title="@string/status_bar_features_category">

        <!--<org.mist.settings.preferences.SecureSettingPrimarySwitchPreference
            android:key="ax_dynamic_bar_enabled"
            android:title="@string/dynamic_bar"
            android:summary="@string/dynamic_bar_enable_summary"
            android:fragment="org.mist.settings.fragments.statusbar.DynamicBar"
            android:defaultValue="false" />

        <org.mist.settings.preferences.SecureSettingPrimarySwitchPreference
            android:key="cutout_progress_enabled"
            android:title="@string/cutout_progress_title"
            android:summary="@string/cutout_progress_summary"
            android:fragment="org.mist.settings.fragments.statusbar.CutoutProgressSettingsFragment"
            android:defaultValue="false" />-->

        <!-- Network traffic -->
        <org.mist.settings.preferences.SystemSettingPrimarySwitchPreference
            android:key="network_traffic_enabled"
            android:title="@string/status_bar_network_traffic_settings_title"
            android:summary="@string/status_bar_network_traffic_settings_summary"
            android:fragment="org.mist.settings.fragments.statusbar.NetworkTrafficSettings"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="status_bar_icons_category"
        android:title="@string/status_bar_icons_category">

        <!-- Status bar tuner -->
        <Preference
            android:key="status_bar_icons"
            android:title="@string/status_bar_tuner_title"
            android:summary="@string/status_bar_tuner_summary">
                <intent android:action="com.android.settings.action.STATUS_BAR_TUNER" />
        </Preference>

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_clock"
            android:title="@string/status_bar_clock_position_title"
            android:summary="%s"
            android:dialogTitle="@string/status_bar_clock_position_title"
            android:entries="@array/status_bar_clock_position_entries"
            android:entryValues="@array/status_bar_clock_position_values"
            android:defaultValue="2" />

        <!-- Clock & date -->
        <Preference
            android:key="clock"
            android:title="@string/status_bar_clock_and_date_title"
            android:summary="@string/status_bar_clock_and_date_summary"
            android:fragment="org.mist.settings.fragments.statusbar.Clock" />

        <!-- Statusbar Clock background chip -->
        <!--<Preference
            android:key="statusbar_clock_chip"
            android:title="@string/statusbar_clock_chip_title"
            android:fragment="org.mist.settings.fragments.statusbar.ClockChipSettings" />-->

        <!-- Bluetooth battery status -->
        <org.mist.settings.preferences.SystemSettingSwitchPreference
            android:key="bluetooth_show_battery"
            android:title="@string/status_bar_bluetooth_battery_title"
            android:summary="@string/status_bar_bluetooth_battery_summary"
            android:defaultValue="true" />

        <!-- Colored icons -->
        <!--<org.mist.settings.preferences.SystemSettingSwitchPreference
            android:key="statusbar_colored_icons"
            android:title="@string/status_bar_colored_icons_title"
            android:summary="@string/status_bar_colored_icons_summary"
            android:defaultValue="false" />

        <org.mist.settings.preferences.SystemSettingSwitchPreference
            android:key="statusbar_notif_count"
            android:title="@string/status_bar_notif_count_title"
            android:summary="@string/status_bar_notif_count_summary"
            android:defaultValue="false" />-->
    </PreferenceCategory>

    <!-- Status bar battery customizations -->
    <PreferenceCategory
        android:title="@string/status_bar_battery_category_title">

        <!-- Battery styles -->
        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_battery_style"
            android:title="@string/status_bar_battery_style_title"
            android:entries="@array/status_bar_battery_style_entries"
            android:entryValues="@array/status_bar_battery_style_values"
            android:defaultValue="0" />

        <!-- Battery percent -->
        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_show_battery_percent"
            android:title="@string/status_bar_battery_percent_title"
            android:entries="@array/status_bar_battery_percent_entries"
            android:entryValues="@array/status_bar_battery_percent_values"
            android:defaultValue="0" />

        <!-- Battery percentage when charging -->
        <!--<org.mist.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_battery_text_charging"
            android:title="@string/status_bar_battery_text_charging_title"
            android:summary="@string/status_bar_battery_text_charging_summary"
            android:defaultValue="true" />

        <org.mist.settings.preferences.SystemSettingPrimarySwitchPreference
            android:key="statusbar_battery_bar"
            android:title="@string/battery_bar_title"
            android:summary="@string/battery_bar_summary"
            android:fragment="org.mist.settings.fragments.statusbar.BatteryBar"
            android:defaultValue="false" />-->

    </PreferenceCategory>

    <!-- Carrier label -->
    <PreferenceCategory
        android:key="status_bar_carrier_key"
        android:title="@string/status_bar_carrier_category_title">

        <org.mist.settings.preferences.SystemSettingListPreference
            android:key="lockscreen_show_carrier"
            android:title="@string/lockscreen_show_carrier_title"
            android:dialogTitle="@string/lockscreen_show_carrier_title"
            android:summary="%s"
            android:entries="@array/status_bar_carrier_display_entries"
            android:entryValues="@array/status_bar_carrier_display_values"
            android:defaultValue="1" />

        <Preference
            android:key="lockscreen_show_custom_carrier_text"
            android:title="@string/custom_carrier_label_title"
            android:summary="@string/custom_carrier_label_summary" />

    </PreferenceCategory>

    <!--<PreferenceCategory
        android:key="status_bar_logo_category"
        android:title="@string/status_bar_logo_title">

        <org.mist.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_logo"
            android:title="@string/status_bar_logo_title"
            android:summary="@string/status_bar_logo_summary"
            android:defaultValue="false" />

        <org.mist.settings.preferences.SystemSettingListPreference
