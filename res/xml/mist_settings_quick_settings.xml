<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/quick_settings_title">

    <PreferenceCategory
        android:key="quick_settings_interface_category"
        android:title="@string/quick_settings_interface_category">

        <!-- QS Header -->
        <org.mist.settings.preferences.SystemSettingPrimarySwitchPreference
            android:key="status_bar_custom_header"
            android:title="@string/quick_settings_header_image_title"
            android:summary="@string/quick_settings_header_image_summary"
            android:fragment="org.mist.settings.fragments.quicksettings.QsHeaderImageSettings"
            android:defaultValue="false" />

        <org.mist.settings.preferences.SystemSettingListPreference
            android:key="qs_header_clock_style"
            android:title="@string/qs_header_clock_style_title"
            android:entries="@array/qs_header_clock_style_entries"
            android:entryValues="@array/qs_header_clock_style_values"
            android:summary="%s"
            android:defaultValue="0" />

        <org.mist.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_stock_media_player"
            android:title="@string/stock_qs_media_player"
            android:summary="@string/stock_qs_media_player_summary"
            android:defaultValue="false" />

        <!-- Waveform seekbar -->
        <org.mist.settings.preferences.SystemSettingSwitchPreference
            android:key="media_waveform_seekbar"
            android:title="@string/media_waveform_seekbar_title"
            android:summary="@string/media_waveform_seekbar_summary"
            android:defaultValue="false" />

        <org.mist.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_compact_media_player_mode"
            android:title="@string/qs_compact_media_player_mode_title"
            android:summary="@string/qs_compact_media_player_mode_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

    <!-- Panel Mode & Side -->
    <PreferenceCategory
        android:key="ax_qs_panel_category"
        android:title="@string/ax_qs_panel_category">

        <org.mist.settings.preferences.SecureSettingListPreference
            android:key="ax_qs_panel_mode"
            android:title="@string/ax_qs_panel_mode_title"
            android:summary="%s"
            android:entries="@array/ax_qs_panel_mode_entries"
            android:entryValues="@array/ax_qs_panel_mode_values"
            android:defaultValue="0" />

        <org.mist.settings.preferences.SecureSettingListPreference
            android:key="ax_qs_quick_panel_on_left"
            android:title="@string/ax_qs_quick_panel_on_left_title"
            android:summary="%s"
            android:entries="@array/ax_qs_quick_panel_on_left_entries"
            android:entryValues="@array/ax_qs_quick_panel_on_left_values"
            android:defaultValue="0" />
    </PreferenceCategory>

    <!-- Quick Quick Settings (QQS) -->
    <PreferenceCategory
        android:key="ax_qqs_category"
        android:title="@string/ax_qqs_category">

        <org.mist.settings.preferences.SecureSettingSeekBarPreference
            android:key="ax_qqs_tile_columns"
            android:title="@string/ax_qqs_tile_columns_title"
            settings:min="2"
            android:max="6"
            settings:interval="1"
            android:defaultValue="4" />

        <org.mist.settings.preferences.SecureSettingSeekBarPreference
            android:key="ax_qqs_tile_rows"
            android:title="@string/ax_qqs_tile_rows_title"
            settings:min="1"
            android:max="3"
            settings:interval="1"
            android:defaultValue="1" />

        <org.mist.settings.preferences.SecureSettingSeekBarPreference
            android:key="ax_qqs_control_columns"
            android:title="@string/ax_qqs_control_columns_title"
            settings:min="1"
            android:max="4"
            settings:interval="1"
            android:defaultValue="2" />
    </PreferenceCategory>

    <!-- Full Quick Settings (QS) -->
    <PreferenceCategory
        android:key="ax_qs_category"
        android:title="@string/ax_qs_category">

        <org.mist.settings.preferences.SecureSettingSeekBarPreference
            android:key="ax_qs_tile_columns"
            android:title="@string/ax_qs_tile_columns_title"
            settings:min="2"
            android:max="6"
            settings:interval="1"
            android:defaultValue="4" />

        <org.mist.settings.preferences.SecureSettingSeekBarPreference
            android:key="ax_qs_tile_rows"
            android:title="@string/ax_qs_tile_rows_title"
            settings:min="2"
            android:max="6"
            settings:interval="1"
            android:defaultValue="3" />

        <org.mist.settings.preferences.SecureSettingSeekBarPreference
            android:key="ax_qs_control_columns"
            android:title="@string/ax_qs_control_columns_title"
            settings:min="1"
            android:max="4"
            settings:interval="1"
            android:defaultValue="2" />

        <org.mist.settings.preferences.SecureSettingSwitchPreference
            android:key="ax_qs_show_tile_labels"
            android:title="@string/ax_qs_show_tile_labels_title"
            android:summary="@string/ax_qs_show_tile_labels_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <!-- Sliders -->
    <PreferenceCategory
        android:key="ax_qs_sliders_category"
        android:title="@string/ax_qs_sliders_category">

        <org.mist.settings.preferences.SecureSettingListPreference
            android:key="ax_qs_brightness_vertical_slider_style"
            android:title="@string/ax_qs_brightness_vertical_slider_style_title"
            android:summary="%s"
            android:entries="@array/ax_qs_slider_style_entries"
            android:entryValues="@array/ax_qs_slider_style_values"
            android:defaultValue="0" />

        <org.mist.settings.preferences.SecureSettingListPreference
            android:key="ax_qs_volume_vertical_slider_style"
            android:title="@string/ax_qs_volume_vertical_slider_style_title"
            android:summary="%s"
            android:entries="@array/ax_qs_slider_style_entries"
            android:entryValues="@array/ax_qs_slider_style_values"
            android:defaultValue="0" />

        <!-- Stock Brightness slider toggle & position -->
        <lineageos.preference.LineageSecureSettingListPreference
            android:key="qs_show_brightness_slider"
            android:title="@string/quick_settings_show_brightness_slider_title"
            android:entries="@array/quick_settings_show_brightness_slider_entries"
            android:entryValues="@array/quick_settings_show_brightness_slider_values"
            android:defaultValue="1" />

        <lineageos.preference.LineageSecureSettingListPreference
            android:key="qs_brightness_slider_position"
            android:title="@string/quick_settings_brightness_slider_position_title"
            android:entries="@array/quick_settings_brightness_slider_position_entries"
            android:entryValues="@array/quick_settings_brightness_slider_position_values"
            android:defaultValue="0" />

        <!-- Haptic feedback on brightness slider -->
        <org.mist.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_brightness_slider_haptic"
            android:title="@string/quick_settings_brightness_slider_haptic_title"
            android:summary="@string/quick_settings_brightness_slider_haptic_summary"
            android:defaultValue="true" />

        <!-- Auto brightness icon -->
        <lineageos.preference.LineageSecureSettingSwitchPreference
            android:key="qs_show_auto_brightness"
            android:title="@string/quick_settings_auto_brightness_icon_title"
            android:summary="@string/quick_settings_auto_brightness_icon_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <!-- Appearance -->
    <PreferenceCategory
        android:key="ax_qs_appearance_category"
        android:title="@string/ax_qs_appearance_category">

        <org.mist.settings.preferences.SecureSettingSeekBarPreference
            android:key="system_blur_radius_pct"
            android:title="@string/ax_qs_blur_radius_title"
            android:summary="@string/ax_qs_blur_radius_summary"
            settings:units="%"
            settings:min="0"
            android:max="100"
            settings:interval="5"
            android:defaultValue="80" />
    </PreferenceCategory>

    <!-- Layout / Spans -->
    <PreferenceCategory
        android:key="ax_qs_layout_category"
        android:title="@string/ax_qs_layout_category">

        <Preference
            android:key="qs_tile_layout_info"
            android:title="@string/ax_qs_tile_layout_info_title"
            android:summary="@string/ax_qs_tile_layout_info_summary"
            android:selectable="false" />

        <Preference
            android:key="qs_reset_layout"
            android:title="@string/ax_qs_reset_layout_title"
            android:summary="@string/ax_qs_reset_layout_summary" />
    </PreferenceCategory>

    <!-- Lock screen -->
    <PreferenceCategory
        android:key="quick_settings_lock_screen_category"
        android:title="@string/quick_settings_lock_screen_category">

        <!-- Hide on secure lock screen -->
        <org.mist.settings.preferences.SecureSettingSwitchPreference
            android:key="enable_lockscreen_quick_settings"
            android:title="@string/quick_settings_secure_lock_screen_title"
            android:summary="@string/quick_settings_secure_lock_screen_summary"
            android:defaultValue="true" />

        <!-- Secure QS tiles require unlock -->
        <org.mist.settings.preferences.SecureSettingSwitchPreference
            android:key="qstile_requires_unlocking"
            android:title="@string/quick_settings_require_unlock_title"
            android:summary="@string/quick_settings_require_unlock_summary"
            android:defaultValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
